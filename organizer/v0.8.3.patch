+@Composable private fun MoneyScreen(db:NoteDatabase,lang:String){
+    var refresh by remember{mutableIntStateOf(0)}
+    var add by remember{mutableStateOf(false)}
+    val list=remember(refresh){db.getMoneyEntries()}
+    val income=list.filter{it.type=="income"}
+    val expense=list.filter{it.type=="expense"}
+    val incTotal=income.sumOf{it.amount}
+    val expTotal=expense.sumOf{it.amount}
+    val balance=incTotal-expTotal
+    Box(Modifier.fillMaxSize()){
+        Column(Modifier.fillMaxSize().padding(horizontal=10.dp,vertical=8.dp)){
+            Row(Modifier.weight(1f).fillMaxWidth(),horizontalArrangement=Arrangement.spacedBy(8.dp)){
+                MoneyColumn(
+                    title=AppStrings.t(lang,"income"),
+                    entries=income,
+                    total=incTotal,
+                    lang=lang,
+                    modifier=Modifier.weight(1f),
+                    amountColor=MaterialTheme.colorScheme.primary,
+                    onDelete={id->db.deleteMoneyEntry(id);refresh++}
+                )
+                MoneyColumn(
+                    title=AppStrings.t(lang,"expense"),
+                    entries=expense,
+                    total=expTotal,
+                    lang=lang,
+                    modifier=Modifier.weight(1f),
+                    amountColor=MaterialTheme.colorScheme.error,
+                    onDelete={id->db.deleteMoneyEntry(id);refresh++}
+                )
+            }
+            Spacer(Modifier.height(8.dp))
+            Card(Modifier.fillMaxWidth().height(48.dp)){
+                Row(Modifier.fillMaxSize().padding(horizontal=12.dp),verticalAlignment=Alignment.CenterVertically){
+                    Text(AppStrings.t(lang,"balance"),style=MaterialTheme.typography.titleSmall,modifier=Modifier.weight(1f))
+                    Text(
+                        (if(balance>0)"+ " else if(balance<0)"− " else "")+"%,.0f ₸".format(kotlin.math.abs(balance)),
+                        style=MaterialTheme.typography.titleMedium,
+                        color=when{balance>0->MaterialTheme.colorScheme.primary;balance<0->MaterialTheme.colorScheme.error;else->MaterialTheme.colorScheme.onSurface}
+                    )
+                }
+            }
+        }
+        FloatingActionButton({add=true},Modifier.align(Alignment.BottomEnd).padding(end=18.dp,bottom=66.dp)){Icon(Icons.Default.Add,null)}
+    }
+    if(add)AddMoneyDialog(lang,{add=false}){type,amount,cat,note->db.addMoneyEntry(type,amount,cat,null,note);refresh++;add=false}
+}
+
+@Composable private fun MoneyColumn(title:String,entries:List<MoneyEntry>,total:Double,lang:String,modifier:Modifier=Modifier,amountColor:Color,onDelete:(Long)->Unit){
+    Column(modifier.fillMaxHeight()){
+        Card(Modifier.fillMaxWidth()){
+            Box(Modifier.fillMaxWidth().height(46.dp),contentAlignment=Alignment.Center){
+                Text(title,style=MaterialTheme.typography.titleMedium)
+            }
+        }
+        Spacer(Modifier.height(6.dp))
+        if(entries.isEmpty()){
+            Box(Modifier.weight(1f).fillMaxWidth(),contentAlignment=Alignment.Center){
+                Text("—",color=MaterialTheme.colorScheme.onSurfaceVariant)
+            }
+        }else{
+            LazyColumn(Modifier.weight(1f).fillMaxWidth(),verticalArrangement=Arrangement.spacedBy(6.dp)){
+                items(entries,key={it.id}){m->MoneyEntryCard(m,lang,amountColor,onDelete)}
+            }
+        }
+        Spacer(Modifier.height(6.dp))
+        Card(Modifier.fillMaxWidth().height(48.dp)){
+            Column(Modifier.fillMaxSize().padding(horizontal=8.dp),verticalArrangement=Arrangement.Center){
+                Text(AppStrings.t(lang,"total"),style=MaterialTheme.typography.labelSmall,color=MaterialTheme.colorScheme.onSurfaceVariant)
+                Text("%,.0f ₸".format(total),style=MaterialTheme.typography.titleSmall,color=amountColor,maxLines=1)
+            }
+        }
+    }
+}
+
+@Composable private fun MoneyEntryCard(m:MoneyEntry,lang:String,amountColor:Color,onDelete:(Long)->Unit){
+    Card(Modifier.fillMaxWidth()){
+        Column(Modifier.fillMaxWidth().padding(horizontal=8.dp,vertical=7.dp)){
+            Row(Modifier.fillMaxWidth(),verticalAlignment=Alignment.CenterVertically){
+                Text("%,.0f ₸".format(m.amount),style=MaterialTheme.typography.titleSmall,color=amountColor,modifier=Modifier.weight(1f),maxLines=1)
+                IconButton({onDelete(m.id)},modifier=Modifier.size(30.dp)){Icon(Icons.Default.Delete,null,Modifier.size(18.dp))}
+            }
+            val label=m.category.ifBlank{m.note.ifBlank{AppStrings.t(lang,"comment")}}
+            Text(label,style=MaterialTheme.typography.bodySmall,maxLines=2,overflow=TextOverflow.Ellipsis)
+            if(m.category.isNotBlank()&&m.note.isNotBlank())Text(m.note,style=MaterialTheme.typography.labelSmall,maxLines=2,overflow=TextOverflow.Ellipsis,color=MaterialTheme.colorScheme.onSurfaceVariant)
+        }
+    }
+}
