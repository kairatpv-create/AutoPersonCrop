+                        if(snoozeMenu){
+                            Row(Modifier.fillMaxWidth(),horizontalArrangement=Arrangement.spacedBy(8.dp)){
+                                listOf(10,30,60).forEach{m->OutlinedButton(onClick={ReminderScheduler.snooze(this@ReminderAlertActivity,r,m);finish()},modifier=Modifier.weight(1f)){Text(if(m<60)"$m мин" else "1 ч")}}
